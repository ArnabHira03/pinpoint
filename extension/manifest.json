{
  "manifest_version": 3,
  "name": "Pinpoint",
  "version": "0.5.0",
  "description": "Drop numbered comment pins on any web page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Pinpoint", "default_popup": "popup.html" }
}
