{
  "manifest_version": 3,
  "name": "Pinpoint",
  "version": "0.3.3",
  "description": "Drop numbered comment pins on any web page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Pinpoint: comment on this page" }
}
